# Copy to .env.local and fill in. Names only: never commit real values.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes; bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI call classification (optional; calls are saved unclassified without it) ---
ANTHROPIC_API_KEY=

# --- ElevenLabs (optional; needed for client lock/unlock) ---
ELEVENLABS_API_KEY=

# --- Google Calendar + Meet for demo booking (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# --- Machine API for the internal AI assistant (optional) ---
# At least 32 characters, and must not equal the service role key.
BODHI_API_KEY=
BODHI_READ_RATE_MAX=
BODHI_WRITE_RATE_MAX=
BODHI_RATE_BUCKET=

# --- Staging integration scripts only (scripts/test-*.mjs) ---
# Point these at a staging project, never production.
BASE_URL=
APP_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
TEST_REP_EMAIL=
TEST_REP_PASSWORD=
TEST_SETTER_EMAIL=
TEST_SETTER_PASSWORD=
